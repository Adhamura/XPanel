[Unit]
# systemd *user* unit: starts XPanel in Steam Game Mode (gamescope-session), which does not run
# the XDG autostart entries. Desktop sessions start XPanel from /etc/xdg/autostart as before;
# ExecCondition skips this unit there, and XPanel is single-instance anyway.
# Enable:  systemctl --user enable --now xpanel.service   (every user: sudo systemctl --global enable xpanel.service)
Description=XPanel Quick Panel (Steam Game Mode)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# exit 0 only in a gamescope session (XDG_CURRENT_DESKTOP=gamescope or GAMESCOPE_WAYLAND_DISPLAY)
ExecCondition=/usr/local/bin/XPanel --is-game-mode
ExecStart=/usr/local/bin/XPanel --background
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
